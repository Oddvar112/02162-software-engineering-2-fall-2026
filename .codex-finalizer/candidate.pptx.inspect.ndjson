{"kind":"textbox","id":"sh/nm9krax0","slide":1,"text":"A digital board game that keeps the chaos and removes the bookkeeping","textPreview":"A digital board game that keeps the chaos and removes the bookkeeping","textChars":69,"textLines":1,"bbox":[70,448,780,92]}
{"kind":"textbox","id":"sh/8n2l0fel","slide":1,"text":"> PROGRAM","textPreview":"> PROGRAM","textChars":9,"textLines":1,"bbox":[916,176,280,38]}
{"kind":"textbox","id":"sh/9obmt0f6","slide":1,"text":"> EXECUTE","textPreview":"> EXECUTE","textChars":9,"textLines":1,"bbox":[916,244,280,38]}
