{"kind":"textbox","id":"sh/m1kn69wf","slide":3,"text":"Product vision","textPreview":"Product vision","textChars":14,"textLines":1,"bbox":[56,78,1168,64]}
{"kind":"textbox","id":"sh/n2tozed0","slide":3,"text":"A shared 3D board that feels physical, while the software handles the rules.","textPreview":"A shared 3D board that feels physical, while the software handles the rules.","textChars":76,"textLines":1,"bbox":[56,150,1100,106]}
