{"kind":"textbox","id":"sh/6xon2dcj","slide":3,"text":"One visible state for every player","textPreview":"One visible state for every player","textChars":34,"textLines":1,"bbox":[56,390,238,110]}
{"kind":"shape","id":"sh/7ixobid4","slide":3,"bbox":[350,314,238,0.01]}
